# 构建期配置模板
# 用法：复制为 .env.local（本地开发）或在 CI 里设为环境变量
# 只有 VITE_ 前缀的变量会被注入前端产物，非 VITE_ 前缀的只对 dev server 生效
#
# ⚠️ 重要：VITE_ 变量会被明文打进前端 JS 产物，任何人都能从浏览器里读到。
#    因此 VITE_PROXY_TOKEN 不是机密，它的作用只是挡住第三方网站盗用你的端点，
#    不要往里塞 API Key。真正的 Key 应该放在代理（Lambda / Worker）的环境变量里。

# ── 应用标识（导航栏标题、浏览器标签页标题）──
VITE_APP_NAME=提示词工坊
VITE_APP_SUBTITLE=Knowledge Card Prompt Workshop

# ── 模型端点 ──
# 指向自建 CORS 代理时，把 scheme 后面的 // 写成单个 /，例如：
#   https://xxx.lambda-url.ap-northeast-1.on.aws/https/api.agnes-ai.cn/v1
# 原因见 README「自建代理」一节。
VITE_TEXT_BASE_URL=https://api.agnes-ai.cn/v1
VITE_DASH_BASE_URL=https://dashscope.aliyuncs.com
# 质检模型独立端点，留空 = 回退到 VITE_TEXT_BASE_URL
VITE_CHECK_BASE_URL=
VITE_SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# ── 代理口令 ──
# 填了它，端点即视为「Key 由代理托管」，访客打开就能用，无需配置任何 Key。
# 留空则走浏览器自带 Key 模式，访客需要在 #/admin 里自己填 Key。
VITE_PROXY_TOKEN=

# ── 模型名 ──
VITE_TEXT_MODEL=agnes-2.5-flash
# 留空 = 回退到 VITE_TEXT_MODEL。换一个不同家族的模型可规避自我偏好偏差
VITE_CHECK_MODEL=
VITE_EXTRACT_MODEL=
VITE_QWEN_MODEL=qwen-image-3.0

# ── Mock 模式 ──
# true = 完全不调 API，用 SVG 占位图跑通全流程（演示 / 无 Key 体验用）
VITE_USE_MOCK=false